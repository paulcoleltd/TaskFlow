# Convex deployment URL — get this from https://dashboard.convex.dev
# after running: npx convex dev
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Set by Convex automatically during npx convex dev
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Required by @convex-dev/auth — generate with:
# npx @convex-dev/auth generate-keys
# Then set in Convex dashboard under Settings > Environment Variables
CONVEX_AUTH_ADAPTER_SECRET=

# Your production site URL (used by @convex-dev/auth for CORS/redirects)
CONVEX_SITE_URL=http://localhost:5174
